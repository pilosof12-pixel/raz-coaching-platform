# Dependencies (Render runs `npm install`)
node_modules/

# Environment / secrets — NEVER commit your Gemini key
.env
.env.local
*.key

# SQLite database + write-ahead logs (created at runtime).
# Patterns are unanchored: the app runs from phase14/, so a root-anchored
# data/*.db never matched the files it was written to ignore.
**/data/*.db
**/data/*.db-*

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
