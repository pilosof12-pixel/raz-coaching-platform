+    2: { sets: '4', reps: '2', note: 'Up to eight high-quality entries only if Week 1 stayed crisp; otherwise repeat the prior ceiling.' },
+    3: { sets: '4', reps: '3', note: 'Up to twelve high-quality entries only if control remains stable; stop before fatigue-driven misses.' },
+    4: { sets: '3', reps: '2', note: 'Consolidation week: reduce attempt exposure and retain only high-quality independent balance practice.' },
+  }[week];
+  const transition = {
+    1: { load: 'Moderate band assistance for a smooth, repeatable bar turnover' },
+    2: { load: 'Slightly lighter band assistance if every Week 1 turnover was clean' },
+    3: { load: 'Lightest band assistance that still preserves a clean bar turnover' },
+    4: { load: 'Moderate band assistance for crisp consolidation singles' },
+  }[week];
+  return { handstand, transition };
+}
+
+function applyYouthVisiblePrimaryProgression(parsed, week, intake, repairs) {
+  const primary = lower(goals(intake, 'primary'));
+  const targets = youthVisibleProgressionTargets(week);
+  let changed = false;
+  parsed.rows.forEach((cells, row) => {
+    const name = String(cells[parsed.exercise] || '').trim();
+    if (/freestanding handstand|unsupported handstand|handstand balance/i.test(primary) && isHandstandEntry(name)) {
+      const before = { sets: cells[parsed.sets], reps: cells[parsed.reps] };
+      cells[parsed.sets] = targets.handstand.sets;
+      cells[parsed.reps] = targets.handstand.reps;
+      if (Number.isInteger(parsed.notes)) cells[parsed.notes] = addCue(cells[parsed.notes], targets.handstand.note, week === 4 ? 'consolidation week' : 'high-quality entries');
+      if (before.sets !== cells[parsed.sets] || before.reps !== cells[parsed.reps]) {
+        repairs.push({ type: 'youth_handstand_visible_progression', week, row, before, after: { sets: cells[parsed.sets], reps: cells[parsed.reps] } });
+        changed = true;
+      }
+    }
+    if (/bar muscle[- ]?up/i.test(primary) && isTransition(name) && Number.isInteger(parsed.load)) {
+      const before = cells[parsed.load];
+      cells[parsed.load] = targets.transition.load;
+      if (before !== cells[parsed.load]) {
+        repairs.push({ type: 'youth_bar_transition_assistance_progression', week, row, before, after: cells[parsed.load] });
+        changed = true;
+      }
+    }
+  });
+  return changed;
+}
