# Copy this file to `.env` for local use, OR set these in Render's
# Environment tab. NEVER commit your real key.

# Your Google AI Studio key (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=your-key-here

# Model (default is gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Port — Render sets this automatically; leave unset in production.
# PORT=8000

# Optional rate limits per client token per day
# DAILY_BUILDS=2
# DAILY_ADJUSTS=8

# Supabase (persistent Postgres). The app uses Supabase when SUPABASE_URL
# plus one of the two keys below is set; otherwise it falls back to local
# SQLite. Get these from your Supabase project: Settings -> API.
#
# PRODUCTION: use SUPABASE_SERVICE_ROLE_KEY. This is a backend-only secret
# that bypasses Row Level Security. Never expose it to the browser. All
# public tables have RLS enabled with no anon policies, so the anon key
# cannot read or write anything.
#
# LOCAL DEV: SUPABASE_ANON_KEY is accepted as a fallback if you are running
# against a dev project without RLS. Do not use it in production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-key
# SUPABASE_ANON_KEY=your-anon-jwt-key   # optional local-dev fallback

# LOCAL DEV ONLY — do not set in production:
# USE_PPLX_PROXY=1
